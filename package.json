{
  "name": "c30-mock",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "description": "仿照教培软件 C30 教师端/学生端的局域网互动教学系统",
  "scripts": {
    "postinstall": "node scripts/rebuild-uiohook.mjs --if-needed",
    "build": "pnpm -r --filter=!@c30/whiteboard-native run build",
    "build:native": "pnpm --filter @c30/whiteboard-native run build",
    "build:win": "pnpm -r run build:win",
    "dev": "pnpm -r --parallel run dev",
    "lint": "pnpm -r run lint",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "rebuild:uiohook": "node scripts/rebuild-uiohook.mjs",
    "verify:uiohook": "node scripts/verify-uiohook.mjs --strict"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.10"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "pnpm": {
    "patchedDependencies": {
      "uiohook-napi": "patches/uiohook-napi.patch"
    }
  }
}
