{
  "name": "@c30/student",
  "version": "0.2.0",
  "private": true,
  "description": "C30 学生端(Electron + vite)",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node ../../scripts/dev-electron.mjs",
    "build": "electron-vite build",
    "build:win": "electron-vite build && node ../../scripts/build-installer.mjs --app student --arch x64",
    "preview": "electron-vite preview",
    "lint": "tsc --noEmit",
    "build:win:arm64": "electron-vite build && node ../../scripts/build-installer.mjs --app student --arch arm64"
  },
  "build": {
    "appId": "com.c30.student",
    "productName": "C30学生端",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "!node_modules/@c30/**",
      "!packages/**"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "icon": "build/icon.ico"
    }
  },
  "dependencies": {
    "@c30/mdsd": "workspace:*",
    "@c30/shared": "workspace:*",
    "@c30/ui": "workspace:*",
    "lucide-react": "^1.74.0",
    "normalize.css": "^8.0.1",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.0"
  }
}
