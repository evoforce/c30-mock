{
  "name": "@c30/teacher",
  "version": "0.2.0",
  "private": true,
  "description": "C30 教师端(Electron + vite)",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node ../../scripts/dev-electron.mjs",
    "predev": "node ../../scripts/verify-uiohook.mjs",
    "build": "electron-vite build",
    "prebuild": "node ../../scripts/verify-uiohook.mjs",
    "build:win": "electron-vite build && node ../../scripts/build-installer.mjs --app teacher --arch x64",
    "preview": "electron-vite preview",
    "lint": "tsc --noEmit",
    "verify:uiohook": "node ../../scripts/verify-uiohook.mjs --strict",
    "build:win:arm64": "electron-vite build && node ../../scripts/build-installer.mjs --app teacher --arch arm64"
  },
  "build": {
    "appId": "com.c30.teacher",
    "productName": "C30教师端",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "assets/**/*",
      "!node_modules/@c30/**",
      "!packages/**"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "icon": "build/icon.ico"
    }
  },
  "dependencies": {
    "@c30/mdsd": "workspace:*",
    "@c30/shared": "workspace:*",
    "@c30/ui": "workspace:*",
    "bufferutil": "^4.2.0",
    "lucide-react": "^1.74.0",
    "normalize.css": "^8.0.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "uiohook-napi": "1.5.5",
    "utf-8-validate": "^6.0.6"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.0"
  }
}
