+// Consume-mode version. Must match CONSUME_MODE_PRESSED_ONLY in main/index.ts.
+//   1 (old, forbidden) = consume PRESSED + RELEASED + DRAGGED. Swallowing DRAGGED
+//       freezes the cursor while the button is held (the "cannot move after press" bug).
+//   2 (current) = consume EVENT_MOUSE_PRESSED only; MOVED/DRAGGED/RELEASED pass through,
+//       so the cursor keeps moving and strokes keep drawing.
+// The JS layer verifies this at startup via getConsumeMode() and refuses to enable
+// setMouseConsume(true) when the check fails, so a stale build can never freeze the mouse.
+//
+// NOTE: keep this file ASCII-only. Chinese comments in a UTF-8 C file are decoded as
+// GBK by MSVC, and a trailing character whose trail byte is 0x5C turns the newline into
+// a line continuation, silently swallowing the next line (this exact bug broke #define
+// and the function body here).
+#define UIOHOOK_CONSUME_MODE_VERSION 2
+
+// Whether to consume the mouse PRESSED event (move/drag/release must pass through).
+static volatile int g_consume_mouse = 0;
+
 void dispatch_proc(uiohook_event* const event) {
+  // Drawing interception: when enabled, set reserved=0x01 on mouse PRESSED only.
+  // libuiohook's mouse_hook_event_proc sees reserved==0x01 and skips
+  // CallNextHookEx, so the event is swallowed (not delivered to the system).
+  //
+  // Why PRESSED only (do NOT add DRAGGED/RELEASED back):
+  //   - Desktop marquee/drag starts when the target receives WM_LBUTTONDOWN and then
+  //     WM_MOUSEMOVE, so swallowing PRESSED alone already prevents accidental marquee;
+  //   - Swallowing DRAGGED/RELEASED makes the system drop the movement itself, which
+  //     freezes the cursor (symptom: pen/eraser "cannot move after pressing the button").
+  if (g_consume_mouse) {
+    switch (event->type) {
