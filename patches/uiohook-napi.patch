+  // Drawing interception: when enabled, mark mouse PRESSED as reserved=0x01;
+  // events. libuiohook's mouse_hook_event_proc sees reserved==0x01 and skips
+  // CallNextHookEx, so the event is swallowed (not delivered to the system).
+  if (g_consume_mouse) {
+    switch (event->type) {
+      case EVENT_MOUSE_PRESSED:
+      /* NOTE: RELEASED/DRAGGED 必须放行,否则拖动时光标被吞、卡死 */
+      /* (libuiohook: reserved==0x01 时跳过 CallNextHookEx → 事件被系统丢弃) */
+        event->reserved = 0x01;
+        break;
+      default:
+        break;
+    }
+  }
